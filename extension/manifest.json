{
  "manifest_version": 3,
  "name": "yt-watcher",
  "version": "1.0.0",
  "description": "Zeigt neben YouTube-Videos eine KI-Zusammenfassung vom lokalen yt-watcher-Dienst.",
  "key": "",
  "host_permissions": ["http://localhost:47816/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
